---
/**
 * Embeds a Streamlit app that runs entirely in the visitor's browser, via
 * stlite (Streamlit compiled to WebAssembly on Pyodide). No server is
 * involved: the Python source listed in the manifest is fetched as static
 * files and executed client-side.
 *
 * The runtime is a large download, so nothing is loaded until the visitor
 * clicks Launch.
 */
export interface Props {
  /** Path to a manifest JSON: { entrypoint, requirements, files[] }. */
  manifest: string;
  title?: string;
  height?: string;
  /** Optional link to a full server-hosted version, shown in the footnote. */
  fullAppUrl?: string;
}

const {
  manifest,
  title = "Live app",
  height = "900px",
  fullAppUrl,
} = Astro.props;

const STLITE_VERSION = "1.12.1";
---

<div class="stlite-shell not-prose my-8 bg-skin-fill">
  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold text-skin-accent">{title}</h2>
    <div class="flex items-center gap-3">
      <span class="text-xs opacity-70">Runs in your browser &middot; your data is never uploaded</span>
      <button
        type="button"
        class="stlite-fullpage-btn hidden rounded-full border border-skin-line/60 px-3 py-1 text-xs transition-colors hover:bg-skin-card dark:hover:bg-gray-800"
        aria-pressed="false"
      >
        Full page
      </button>
    </div>
  </div>

  <div
    class="stlite-embed relative overflow-hidden rounded-lg border border-skin-line/60"
    style={`min-height:${height}`}
    data-manifest={manifest}
    data-stlite-version={STLITE_VERSION}
    data-full-app={fullAppUrl}
  >
    <!-- Placeholder: replaced by the app once the visitor opts in -->
    <div class="stlite-gate flex h-full flex-col items-center justify-center gap-4 px-6 py-20 text-center" style={`min-height:${height}`}>
      <p class="max-w-md text-sm opacity-80">
        This loads a full Python environment (Pyodide, pandas and Plotly) into your
        browser, around 30&ndash;60&nbsp;seconds on a first visit. Nothing you open or
        upload leaves your computer.
      </p>
      <button
        type="button"
        class="stlite-launch rounded-full border border-skin-line/60 px-5 py-2 text-sm transition-colors hover:bg-skin-card hover:scale-105 dark:hover:bg-gray-800"
      >
        Launch {title}
      </button>
      {fullAppUrl && (
        <a href={fullAppUrl} target="_blank" rel="noopener" class="text-xs underline opacity-70 hover:opacity-100">
          or open the hosted version instead
        </a>
      )}
    </div>

    <div class="stlite-status hidden px-6 py-20 text-center text-sm opacity-80"></div>
    <div class="stlite-root hidden h-full w-full" style={`min-height:${height}`}></div>
  </div>
</div>

<!--
  is:inline keeps this out of the Vite pipeline. The stlite runtime must be
  imported from the CDN at runtime; a bundled dynamic import gets rewritten
  and pulls in Vite's preload helper, which is not defined on the page.
-->
<script is:inline>
  (function () {
    // Pages hosting an app render without Astro's ClientRouter (see
    // SoftwareDetails), so each visit is a full page load and stlite always
    // starts in a fresh document - relaunching it inside a long-lived one
    // left its loading toast stuck over the app.
    //
    // This still holds up if the component lands on a page that does use the
    // router. The router runs an inline script only the first time it appears
    // in a session, so the machinery is installed once, bind() attaches it to
    // each fresh copy of the markup on every astro:page-load, and teardown()
    // unmounts running apps when the visitor leaves.
    if (window.__stliteEmbeds) {
      window.__stliteEmbeds.bind();
      return;
    }

    // Controllers of mounted apps, so they can be torn down on navigation.
    const running = new Set();

    function statusEl(box) {
      return box.querySelector(".stlite-status");
    }

    function setStatus(box, msg) {
      const el = statusEl(box);
      if (el) {
        el.textContent = msg;
        el.classList.remove("hidden");
      }
    }

    // Streamlit's multipage navigation writes its own URLs (.../Scatter_Plot)
    // into the page's history. Embedded, that takes the page over: the "Go
    // back" button and the browser's Back step through app pages instead of
    // leaving, and the rewritten URL 404s on refresh because no such page
    // exists on the site. So the page's URL and history stay as they are:
    // Streamlit's writes are dropped and its new entries become in-place
    // updates. Navigation inside the app still works, because Streamlit
    // switches pages by rerunning the script, not by loading the URL.
    function pinHistory() {
      if (window.__stliteHistoryPinned) return;
      // Pages using Astro's router need real history entries to navigate.
      // App pages render without it (see SoftwareDetails), so this applies
      // there; anywhere else, leave history alone.
      if (document.querySelector('meta[name="astro-view-transitions-enabled"]')) return;
      window.__stliteHistoryPinned = true;
      const replace = history.replaceState.bind(history);
      history.pushState = function (state, title) { replace(state, title); };
      history.replaceState = function (state, title) { replace(state, title); };
    }

    async function boot(box) {
      const gate = box.querySelector(".stlite-gate");
      const root = box.querySelector(".stlite-root");
      const manifestUrl = box.dataset.manifest;
      const version = box.dataset.stliteVersion;
      if (!gate || !root || !manifestUrl || !version) return;

      gate.classList.add("hidden");
      setStatus(box, "Loading the Python runtime\u2026 this takes a moment on a first visit.");

      try {
        const base = manifestUrl.replace(/[^/]+$/, "");
        const res = await fetch(manifestUrl);
        if (!res.ok) throw new Error("manifest " + res.status);
        const manifest = await res.json();

        // stlite fetches each file itself, so the Python source is never
        // bundled into the page.
        const files = {};
        manifest.files.forEach(function (name) {
          files[name] = { url: base + name };
        });

        const cdn = "https://cdn.jsdelivr.net/npm/@stlite/browser@" + version + "/build/";

        // stlite.css carries Streamlit's styles AND the Material Symbols
        // @font-face. Without it the UI renders icon ligatures as raw text
        // ("keyboard_double_arrow_right" instead of an arrow).
        await new Promise(function (resolve) {
          if (document.querySelector('link[data-stlite-css="' + version + '"]')) return resolve();
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = cdn + "stlite.css";
          link.setAttribute("data-stlite-css", version);
          link.onload = resolve;
          link.onerror = resolve; // a missing stylesheet should not block the app
          document.head.appendChild(link);
        });

        const mod = await import(cdn + "stlite.js");

        setStatus(box, "Starting the app\u2026");
        root.classList.remove("hidden");

        // The visitor may have navigated away while the runtime downloaded.
        if (!box.isConnected) return;

        pinHistory();

        const app = mod.mount(
          {
            entrypoint: manifest.entrypoint,
            requirements: manifest.requirements || [],
            files: files,
            streamlitConfig: {
              "client.toolbarMode": "minimal",
            },
          },
          root
        );
        running.add(app);

        const el = statusEl(box);
        if (el) el.classList.add("hidden");

        // the button lives in the header, a sibling of the embed box
        const shell = box.closest(".stlite-shell");
        const fsBtn = shell && shell.querySelector(".stlite-fullpage-btn");
        if (fsBtn) fsBtn.classList.remove("hidden");
      } catch (err) {
        console.error("[stlite] failed to start", err);
        const full = box.dataset.fullApp;
        setStatus(
          box,
          "The in-browser app could not start in this browser." +
            (full ? " You can open the hosted version at " + full : "")
        );
        root.classList.add("hidden");
      }
    }

    // Full page: the shell (header included, so the exit control stays
    // reachable) is pinned over the viewport. This only toggles classes, so
    // the running app is never torn down and reloaded.
    function setFullPage(shell, on) {
      shell.classList.toggle("stlite-fullpage", on);
      document.documentElement.classList.toggle("stlite-fullpage-open", on);
      const btn = shell.querySelector(".stlite-fullpage-btn");
      if (btn) {
        btn.textContent = on ? "Exit full page" : "Full page";
        btn.setAttribute("aria-pressed", String(on));
      }
      // Streamlit and Plotly re-lay out on resize.
      window.dispatchEvent(new Event("resize"));
    }

    // Attach to every embed on the page that is not attached yet. Each copy
    // of the markup is bound exactly once, however often this runs.
    function bind() {
      document.querySelectorAll(".stlite-shell").forEach(function (shell) {
        if (shell.dataset.stliteBound) return;
        shell.dataset.stliteBound = "true";

        const fsBtn = shell.querySelector(".stlite-fullpage-btn");
        if (fsBtn) {
          fsBtn.addEventListener("click", function () {
            setFullPage(shell, !shell.classList.contains("stlite-fullpage"));
          });
        }

        const box = shell.querySelector(".stlite-embed");
        const launch = box && box.querySelector(".stlite-launch");
        if (launch) launch.addEventListener("click", function () { boot(box); }, { once: true });
      });
    }

    // Leaving the page. A mounted app keeps a whole Python runtime alive in a
    // worker until it is unmounted, and a page left in full-page mode would
    // carry its scroll lock over to the next page.
    function teardown() {
      running.forEach(function (app) {
        try {
          app.unmount();
        } catch (err) {
          console.warn("[stlite] unmount failed", err);
        }
      });
      running.clear();
      document.documentElement.classList.remove("stlite-fullpage-open");
    }

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      const open = document.querySelector(".stlite-shell.stlite-fullpage");
      if (open) setFullPage(open, false);
    });
    document.addEventListener("astro:page-load", bind);
    document.addEventListener("astro:before-swap", teardown);

    window.__stliteEmbeds = { bind: bind };
    bind();
  })();
</script>

<style is:global>
  /* stlite ships Streamlit's own stylesheet; keep it inside the embed box. */
  .stlite-embed .stlite-root > iframe,
  .stlite-embed .stlite-root > div {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .stlite-embed [data-testid="stAppViewContainer"] {
    background: transparent;
  }

  /* base.css applies `svg { h-6 w-6 }` globally so the site's icons are 24px.
     That also hits every SVG the embedded app draws, collapsing Plotly's
     chart canvas to a 24x24 square. Inside the embed, let each SVG size
     itself from its own width/height attributes again. */
  .stlite-embed svg {
    width: auto;
    height: auto;
  }

  /* base.css also sets `section, footer { mx-auto max-w-3xl px-4 }`. Streamlit's
     main area is a <section>, so that clamped the app to 768px and silently
     undid its own wide layout. The sidebar keeps the cap Streamlit gives it. */
  .stlite-embed section:not([data-testid="stSidebar"]),
  .stlite-embed footer {
    max-width: none;
    margin-left: 0;
    margin-right: 0;
  }

  /* Full page. The inline min-height on the box must be overridden, hence the
     !important, and 100dvh keeps mobile browser chrome from clipping it. */
  html.stlite-fullpage-open,
  html.stlite-fullpage-open body {
    overflow: hidden;
  }
  .stlite-shell.stlite-fullpage {
    position: fixed;
    inset: 0;
    z-index: 60;
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.75rem 0;
  }
  .stlite-shell.stlite-fullpage .stlite-embed {
    flex: 1 1 auto;
    min-height: 0 !important;
    border-radius: 0;
  }
  .stlite-shell.stlite-fullpage .stlite-root {
    min-height: 0 !important;
    height: 100%;
  }
</style>
